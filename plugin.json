{
  "id": "navidrome",
  "name": "Navidrome",
  "version": "0.1.2",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": { "network": ["*"] },
  "settings": [
    { "key": "server", "label": "服务器地址", "help": "例如 https://music.example.com，支持子路径" },
    { "key": "username", "label": "用户名" },
    { "key": "password", "label": "密码", "help": "Navidrome 账号密码；请使用 HTTPS" }
  ],
  "navigation": [
    { "title": "发现音乐", "builtin": "home" },
    { "title": "我喜欢的音乐", "builtin": "liked" },
    { "title": "我喜欢的艺人", "page": "liked-artists", "icon": "star" },
    { "title": "我喜欢的专辑", "builtin": "savedAlbums" },
    { "title": "专辑", "page": "albums", "icon": "album" },
    { "title": "艺人", "page": "artists", "icon": "artist" }
  ]
}
